LANG=C.UTF-8
PATH=/opt/factory-ci/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DOTNET_INSTALL_DIR=/opt/factory-ci/dotnet
DOTNET_NOLOGO=1
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/factory-ci/bin/job-started
ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/opt/factory-ci/bin/job-completed
RUNNER_TOOL_CACHE=/opt/hostedtoolcache
AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache
