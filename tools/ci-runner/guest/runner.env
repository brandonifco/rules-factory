LANG=C.UTF-8
PATH=/opt/factory-ci/node/bin:/opt/factory-ci/gh/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DOTNET_INSTALL_DIR=/opt/factory-ci/dotnet
DOTNET_NOLOGO=1
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
# As on the hosted image: `pip install` into the system Python succeeds there, and here lands in
# the account's ~/.local, since the system site is root's (rules-corpus, rules-kernel install so).
PIP_BREAK_SYSTEM_PACKAGES=1
ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/factory-ci/bin/job-started.sh
ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/opt/factory-ci/bin/job-completed.sh
RUNNER_TOOL_CACHE=/opt/hostedtoolcache
AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache
