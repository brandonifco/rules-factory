# Pinned toolchain of the factory-ci guest. setup-guest.sh installs exactly these and refuses a
# download whose hash differs. Change a line here, then run `factory-ci setup` again.
RUNNER_VERSION=2.338.0
RUNNER_SHA256=af4b794c1bc41d73d40535e3fe092a39f9679cd8d965954c2aca25a05ca41d32
# Every engine's global.json pins its SDK with rollForward disabled; list each pinned version.
DOTNET_SDKS="10.0.112"
DOTNET_SDK_SHA512_10_0_112=1ac949dfd3929855e3a102a5b12f843967a784ad2d911dfcfff6abdf81a2e78bccf25ddc055547de02b36133bf792aaf97fcba8db8aa6b52ac2e018b86935d05
# Runtimes a test project targets besides the SDK's own (the engines test net8.0 and net10.0; the
# hosted image ships the .NET 8 runtime).
DOTNET_RUNTIMES="8.0.31"
DOTNET_RUNTIME_SHA512_8_0_31=f336bdec58d54bf50d74a1b38efa82f7290d976bd2ed98b845ebcbac42cf0d8cef504684fc088d4b05f98737b996bf3302e52bd9c23005deae7c60780b2652fb
# The GitHub CLI, which the hosted image ships and the engines' pr-policy and conformance-gate call.
GH_VERSION=2.102.0
GH_SHA256=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
NODE_VERSION=22.23.3
NODE_SHA256=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
# Ubuntu packages a job may expect on a GitHub-hosted ubuntu-24.04 image and cannot install
# itself (runner accounts have no sudo).
APT_PACKAGES="git curl jq unzip zip xz-utils ca-certificates python3 python3-venv python3-pip libicu74 poppler-utils sysstat"
# Read-only tool cache in the hosted image's layout, for actions/setup-python. A job asking for a
# version not here fails visibly instead of downloading into a cache another job could change.
PYTHON_TOOLCACHE_VERSION=3.12.15
PYTHON_TOOLCACHE_URL=https://github.com/actions/python-versions/releases/download/3.12.15-36805895057/python-3.12.15-linux-24.04-x64.tar.gz
PYTHON_TOOLCACHE_SHA256=fcb672b0437c2d8df5565b7cc250b2b0d7455e2b8d6a4a107cfa6f2efe4f7ed8
