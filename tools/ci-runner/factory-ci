#!/bin/bash
# factory-ci -- operate the self-hosted GitHub Actions runner VM for the owner's trusted runs
# (docs/self-hosted-runners.md). A private repository has a standing runner registration; a public
# one never does, and its owner's runs reach the VM only through the trusted dispatcher (decision
# 0080). Runs on the KVM host as a user in the `libvirt` group; needs no sudo. Every guest-side
# change goes through the guest's admin account over SSH.
set -euo pipefail
kit="$(cd "$(dirname "$0")" && pwd)"
VM="${FACTORY_CI_VM:-factory-ci-1}"
IP="${FACTORY_CI_IP:-192.168.150.11}"
KEY="${FACTORY_CI_KEY:-$HOME/.ssh/factory-ci_ed25519}"
KNOWN="${FACTORY_CI_KNOWN_HOSTS:-$HOME/.ssh/known_hosts.factory-ci}"
GH="${FACTORY_CI_GH:-gh}"
IMAGE_RELEASE="${FACTORY_CI_IMAGE_RELEASE:-release-20260926}"
IMAGE_SHA256="${FACTORY_CI_IMAGE_SHA256:-6a81c37564db9b1ee84e141922625e1d7c5b389b99bb3c572e0243607d5bb4d2}"
VCPUS="${FACTORY_CI_VCPUS:-6}" MEMORY_MB="${FACTORY_CI_MEMORY_MB:-12288}" DISK="${FACTORY_CI_DISK:-100G}"
LABELS='["self-hosted","linux","x64","factory-ci"]'
virsh() { command virsh -c qemu:///system "$@"; }
guest() { ssh -i "$KEY" -o UserKnownHostsFile="$KNOWN" -o StrictHostKeyChecking=accept-new -o BatchMode=yes \
            -o ConnectTimeout=5 "ciadmin@$IP" "$@"; }
die() { echo "factory-ci: $*" >&2; exit 1; }
name_of() { local r="${1#*/}"; r="${r,,}"; echo "${r//[^a-z0-9-]/-}"; }
need_repo() { [[ ${1:-} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "give OWNER/REPO"; }
is_private() { [[ "$("$GH" api "repos/$1" --jq .private)" == true ]]; }
dispatch_py() { python3 -I "$kit/dispatch.py" "$@"; }

cmd_provision() { # create the network, filter and VM from the pinned cloud image
  virsh dominfo "$VM" >/dev/null 2>&1 && die "$VM already exists (rebuild: factory-ci destroy-vm first)"
  [[ -f $KEY ]] || ssh-keygen -q -t ed25519 -N '' -C "factory-ci admin (host only)" -f "$KEY"
  virsh net-info factory-ci >/dev/null 2>&1 || { virsh net-define "$kit/host/network.xml"; virsh net-autostart factory-ci; }
  virsh net-start factory-ci 2>/dev/null || true
  virsh nwfilter-define "$kit/host/nwfilter.xml" >/dev/null
  local work base="factory-ci-base-noble-${IMAGE_RELEASE#release-}.qcow2"
  work="$(mktemp -d)"; trap 'rm -rf "$work"' RETURN
  if ! virsh vol-info --pool default "$base" >/dev/null 2>&1; then
    local url="https://cloud-images.ubuntu.com/releases/noble/$IMAGE_RELEASE/ubuntu-24.04-server-cloudimg-amd64.img"
    curl -fsSL -o "$work/base.img" "$url"
    echo "$IMAGE_SHA256  $work/base.img" | sha256sum -c --quiet - || die "cloud image hash mismatch"
    virsh vol-create-as default "$base" "$(stat -c %s "$work/base.img")" --format qcow2 >/dev/null
    virsh vol-upload --pool default "$base" "$work/base.img"
  fi
  mkdir "$work/seed"
  sed "s#@ADMIN_KEY@#$(cat "$KEY.pub")#; s#factory-ci-1#$VM#g" "$kit/host/user-data.yaml" > "$work/seed/user-data"
  printf 'instance-id: %s\nlocal-hostname: %s\n' "$VM" "$VM" > "$work/seed/meta-data"
  cp "$kit/host/network-config.yaml" "$work/seed/network-config"
  xorriso -as mkisofs -quiet -output "$work/seed.iso" -volid cidata -joliet -rock \
    "$work/seed/user-data" "$work/seed/meta-data" "$work/seed/network-config"
  virsh vol-create-as default "$VM-seed.iso" "$(stat -c %s "$work/seed.iso")" --format raw >/dev/null
  virsh vol-upload --pool default "$VM-seed.iso" "$work/seed.iso"
  virsh vol-clone --pool default "$base" "$VM.qcow2" >/dev/null
  virsh vol-resize --pool default "$VM.qcow2" "$DISK" >/dev/null
  virt-install --connect qemu:///system --name "$VM" --description "rules-factory self-hosted CI runner" \
    --memory "$MEMORY_MB" --vcpus "$VCPUS" --cpu host-passthrough --os-variant ubuntu24.04 \
    --disk "vol=default/$VM.qcow2,bus=virtio,cache=none,discard=unmap" \
    --disk "vol=default/$VM-seed.iso,device=cdrom,bus=sata,readonly=on" \
    --network network=factory-ci,model=virtio,mac=52:54:00:fc:01:01,filterref=factory-ci-egress \
    --graphics none --console pty,target_type=serial --noautoconsole --import --autostart
  ssh-keygen -R "$IP" -f "$KNOWN" >/dev/null 2>&1 || true
  echo "waiting for cloud-init..."; for _ in $(seq 60); do guest 'cloud-init status --wait' 2>/dev/null && return 0; sleep 5; done
  die "guest did not come up"
}
cmd_setup() { # install or update the guest baseline (toolchain, hooks, units)
  tar -C "$kit/guest" -czf - . | guest 'rm -rf ~/kit && mkdir ~/kit && tar -xzf - -C ~/kit && sudo ~/kit/setup-guest.sh'
}
cmd_register() { # OWNER/REPO: register (or re-register) this VM's runner for one private repository
  need_repo "${1:-}"; local repo="$1" name; name="$(name_of "$repo")"
  is_private "$repo" || die "$repo is public: a standing runner would take a fork's job; use trust (decision 0080)"
  "$GH" api -X POST "repos/$repo/actions/runners/registration-token" --jq .token |
    guest "sudo /opt/factory-ci/bin/register '$name' '$repo'"
  cmd_runners "$repo"
}
cmd_deregister() { # OWNER/REPO: remove this VM's runner for one repository, here and on GitHub
  need_repo "${1:-}"; local repo="$1" user; user="fci-$(name_of "$repo")"
  guest "sudo systemctl disable --now factory-ci-runner@$user"
  "$GH" api -X POST "repos/$repo/actions/runners/remove-token" --jq .token |
    guest "cd /srv/factory-ci/$user/runner && sudo -u $user env ACTIONS_RUNNER_INPUT_TOKEN=\"\$(cat)\" ./config.sh remove"
}
cmd_trust() { # OWNER/REPO: serve a public repository's owner runs by dispatch (decision 0080)
  need_repo "${1:-}"; local repo name standing
  repo="$("$GH" api "repos/$1" --jq .full_name)"; name="$(name_of "$repo")"
  standing="$("$GH" api "repos/$repo/actions/runners" --jq "[.runners[].name | select(startswith(\"$VM-jit-\") | not)] | join(\" \")")"
  [[ -z $standing ]] || die "$repo has standing runner(s) $standing; remove them first (deregister)"
  # Not the boundary (the dispatcher and the guest are): one more door a fork must get through.
  "$GH" api -X PUT "repos/$repo/actions/permissions/fork-pr-contributor-approval" -f approval_policy=all_external_contributors
  guest "sudo /opt/factory-ci/bin/dispatch-guest trust '$name' '$repo'"
}
cmd_untrust() { # OWNER/REPO: stop serving a repository by dispatch; its runs go back to hosted runners
  need_repo "${1:-}"
  "$GH" variable delete FACTORY_RUNS_ON_TRUSTED --repo "$1" 2>/dev/null || true
  guest "sudo /opt/factory-ci/bin/dispatch-guest untrust '$(name_of "$1")'"
}
cmd_enable() { # OWNER/REPO: send its runs to the VM: all of a private one's, the owner's of a public one
  need_repo "${1:-}"
  if is_private "$1"; then "$GH" variable set FACTORY_RUNS_ON --repo "$1" --body "$LABELS"; return; fi
  guest "test -f /etc/factory-ci/dispatch/$(name_of "$1")" || die "$1 is public and not served by dispatch: trust it first"
  "$GH" variable list --repo "$1" --json name --jq '.[].name' | grep -qx FACTORY_RUNS_ON &&
    die "$1 is public and has FACTORY_RUNS_ON, which sends a fork's run to the VM too; delete it (disable)"
  "$GH" variable set FACTORY_RUNS_ON_TRUSTED --repo "$1" --body "$LABELS"
}
cmd_disable() { # OWNER/REPO: return its runs to GitHub-hosted runners (billable when private; owner's decision)
  need_repo "${1:-}"; local v gone=
  for v in FACTORY_RUNS_ON FACTORY_RUNS_ON_TRUSTED; do "$GH" variable delete "$v" --repo "$1" 2>/dev/null && gone=1; done
  [[ -n $gone ]] || die "$1 had neither variable"
}
cmd_dispatch() { # the trusted dispatcher in the foreground (the user service runs this)
  exec python3 -I "$kit/dispatch.py" run; }
cmd_install_dispatcher() { # install and start the dispatcher as a systemd user service on this host
  local dir="$HOME/.config/systemd/user"; mkdir -p "$dir"
  sed "s#@KIT@#$kit#g" "$kit/host/factory-ci-dispatch.service" > "$dir/factory-ci-dispatch.service"
  systemctl --user daemon-reload; systemctl --user enable --now factory-ci-dispatch
  [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" == yes ]] ||
    echo "factory-ci: lingering is off for $USER, so the dispatcher stops at logout: loginctl enable-linger $USER"
}
cmd_dispatch_check() { # prove the dispatcher's token file serves every served repository; exit 1 if not
  dispatch_py check; }
cmd_audit() { # registrations, labels, visibility, variables, fork approval as one boundary; exit 1 on a finding
  dispatch_py audit; }
cmd_timings() { # OWNER/REPO [N]: queue and run time of the last N runs' jobs, hosted against factory-ci
  need_repo "${1:-}"; dispatch_py timings "$@"; }
cmd_runners() { # [OWNER/REPO]: GitHub's view of the runners (all registered repositories by default)
  local repos="${1:-$(guest 'ls /srv/factory-ci' | sed -n 's/^fci-//p')}" r
  for r in $repos; do
    [[ $r == */* ]] || r="$("$GH" api user --jq .login)/$r"
    "$GH" api "repos/$r/actions/runners" --jq ".runners[] | \"$r: \(.name) \(.status) busy=\(.busy) [\([.labels[].name]|join(\",\"))]\"" 2>/dev/null ||
      echo "$r: cannot read runners"
  done
}
cmd_status() { # VM, guest services, slots, load, and GitHub's view
  echo "== host"; virsh domstate "$VM" --reason; virsh net-info factory-ci | grep -E 'Active|Autostart'
  virsh dominfo "$VM" | grep -E 'Autostart|CPU\(s\)|Max memory'
  echo "== guest"; guest 'uptime; df -h / | tail -1; free -m | sed -n 2p
    systemctl list-units --plain --no-legend "factory-ci-runner@*" | awk "{print \$1, \$3, \$4}"
    echo "slots: $(cat /etc/factory-ci/slots)"; cat /run/factory-ci/hold-* 2>/dev/null | sed "s/^/held: /" || true'
  echo "== dispatch"; systemctl --user is-active factory-ci-dispatch 2>/dev/null | sed 's/^/dispatcher: /' || true
  guest 'sudo /opt/factory-ci/bin/dispatch-guest inventory' | grep -v '^persistent' || true
  echo "== github"; cmd_runners
}
cmd_queue() { # OWNER/REPO: queued and running workflow runs
  need_repo "${1:-}"
  for s in queued in_progress; do
    "$GH" api "repos/$1/actions/runs?status=$s&per_page=20" --jq ".workflow_runs[] | \"$s \(.id) \(.name) \(.head_branch) \(.created_at)\""
  done
}
cmd_logs() { # OWNER/REPO|dispatch [journalctl args]: a runner's journal, or the dispatcher's
  if [[ ${1:-} == dispatch ]]; then shift; journalctl --user -u factory-ci-dispatch --no-pager "${@:--n 100}"; return; fi
  need_repo "${1:-}"; local user; user="fci-$(name_of "$1")"; shift
  guest "sudo journalctl -u factory-ci-runner@$user -u 'factory-ci-jit-*' --no-pager ${*:--n 100}"
}
cmd_slots() { # N: let the VM run N jobs at once (1-4); measure before raising it
  [[ ${1:-} =~ ^[1-4]$ ]] || die "slots must be 1-4"; guest "echo $1 | sudo tee /etc/factory-ci/slots >/dev/null"; echo "slots: $1"
}
cmd_runner() { # start|stop|restart [OWNER/REPO]: the runner service(s) in the guest
  local action="${1:-}" unit='factory-ci-runner@*'
  [[ $action =~ ^(start|stop|restart)$ ]] || die "start|stop|restart"
  [[ -n ${2:-} ]] && unit="factory-ci-runner@fci-$(name_of "$2")"
  if [[ $action == start && -z ${2:-} ]]; then
    guest 'for d in /srv/factory-ci/fci-*; do sudo systemctl start "factory-ci-runner@${d##*/}"; done'
  else guest "sudo systemctl $action '$unit'"; fi
}
cmd_ssh() { # [COMMAND]: the guest's admin shell
  guest "$@"; }
cmd_start() { # start the VM (it also starts with the host: autostart)
  virsh start "$VM"; }
cmd_stop() { # shut the VM down gracefully: a running job may finish first (TimeoutStopSec)
  virsh shutdown "$VM"; }
cmd_restart() { # reboot the VM; the runners come back by themselves
  virsh reboot "$VM"; }
cmd_destroy_vm() { # remove the VM and its disks (registrations on GitHub stay until deregistered)
  virsh destroy "$VM" 2>/dev/null || true
  virsh undefine "$VM" --nvram 2>/dev/null || virsh undefine "$VM"
  virsh vol-delete --pool default "$VM.qcow2"; virsh vol-delete --pool default "$VM-seed.iso"
}
usage() { sed -n 's/^cmd_\([a-z_]*\)() { # \(.*\)$/\1\t\2/p' "$0" | while IFS=$'\t' read -r n d; do printf '  %-18s %s\n' "${n//_/-}" "$d"; done; }
c="${1:-}"; shift || true
case "$c" in
  ""|-h|--help|help) echo "factory-ci COMMAND"; usage ;;
  *) declare -F "cmd_${c//-/_}" >/dev/null || { usage; exit 2; }; "cmd_${c//-/_}" "$@" ;;
esac
